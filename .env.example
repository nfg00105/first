# Supabase (공개 가능한 publishable 키만 사용. service_role 키는 절대 넣지 않습니다)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 네이버 검색 API(뉴스). https://developers.naver.com 에서 애플리케이션 등록 후 발급.
# 서버 전용 값이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다. 없으면 뉴스 패널에 안내 문구가 표시된다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
